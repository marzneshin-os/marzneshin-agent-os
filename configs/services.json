{
    "agentmemory": {
        "command": "bash -c 'source ~/.nvm/nvm.sh && cd /home/asus/code/agentmemory-official && node dist/cli.mjs'",
        "port": 3111,
        "env": {
            "XDG_DATA_HOME": "./state",
            "EMBEDDING_PROVIDER": "local",
            "AGENTMEMORY_AUTO_COMPRESS": "true",
            "LOCAL_LLM_URL": "http://127.0.0.1:8086/v1",
            "LOCAL_LLM_MODEL": "auto"
        },
        "health": {
            "type": "http",
            "path": "/agentmemory/livez",
            "expected_status": [
                200
            ],
            "timeout_s": 2,
            "critical": true
        }
    },
    "ccr": {
        "command": "bash -c 'source ~/.nvm/nvm.sh && ccr start --no-open --gateway'",
        "port": 3456,
        "check_ports": [
            3456,
            3458
        ],
        "description": "Claude Code Router \u2014 multi-model gateway (API on 3456, Web UI on 3458)",
        "health": {
            "type": "http",
            "path": "/",
            "expected_status": [
                200
            ],
            "timeout_s": 2,
            "critical": true
        }
    },
