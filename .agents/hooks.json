{
  "superpowers-check": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "node -e \"process.stdout.write('[Superpowers active: verify skills before action]\\n')\""
      }
    ]
  },
  "auto-approve-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/auto-approve.cjs"
          }
        ]
      }
    ]
  },
  "agentmemory-gravitas": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./plugin/scripts/antigravity-bridge.mjs SessionStart --guard-only",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "view_file|view_line_range|view_code_item|read_file|edit_file|replace_file_content|multi_replace_file_content|write_to_file|create_file|grep_search|codebase_search|find_by_name|list_dir|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./plugin/scripts/antigravity-bridge.mjs PreToolUse --guard-only",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "view_file|view_line_range|view_code_item|read_file|edit_file|replace_file_content|multi_replace_file_content|write_to_file|create_file|grep_search|codebase_search|find_by_name|list_dir|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./plugin/scripts/antigravity-bridge.mjs PostToolUse --guard-only",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./plugin/scripts/antigravity-bridge.mjs Stop --guard-only",
        "timeout": 10
      }
    ]
  }
}
