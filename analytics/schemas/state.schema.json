{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analytics/schemas/state.schema.json",
  "title": "STATE",
  "description": "The compacted snapshot (BUILD-SPEC §3.1). Derived, never truth: always rebuildable from the event log and receipt chain via scripts/compact.py. Mirrors scripts/lib/state.py and leaves room for the richer §3.1 fields (transport_health, counter_kpis, sim, degraded_sense) as slices land.",
  "type": "object",
  "required": ["schema_version", "generated_at", "phase", "active_slice", "workstreams", "kill_switch"],
  "properties": {
    "schema_version": {"type": "string", "const": "2.0.0"},
    "generated_at": {"type": "string"},
    "generated_by": {"type": "string"},
    "compacted_from_events": {"type": "integer", "minimum": 0},
    "compacted_event_hash": {"type": ["string", "null"]},
    "compacted_from": {
      "type": "object",
      "properties": {
        "until_ts": {"type": "string"},
        "event_count": {"type": "integer", "minimum": 0},
        "actor_seq_watermarks": {"type": "object", "additionalProperties": {"type": "integer"}}
      }
    },
    "phase": {"type": "string", "minLength": 1},
    "active_slice": {"type": "string", "pattern": "^VS-\\d+$"},
    "tick_level": {"type": "string"},
    "sense_level": {"type": "string"},
    "transport_health": {
      "type": "object",
      "properties": {
        "T1": {"$ref": "#/$defs/transportStatus"},
        "T2": {"$ref": "#/$defs/transportStatus"},
        "T3": {"$ref": "#/$defs/transportStatus"},
        "active_default": {"type": "string", "enum": ["T1", "T2", "T3"]},
        "fallback_to": {"type": "string", "enum": ["T1", "T2", "T3"]}
      }
    },
    "workstreams": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "owner_agent": {"type": "string"},
          "lease": {
            "type": ["object", "null"],
            "properties": {
              "holder": {"type": "string"},
              "fencing_token": {"type": "integer"},
              "expires_at": {"type": "string"},
              "heartbeat_at": {"type": "string"}
            }
          },
          "open_tasks": {"type": "array", "items": {"type": "string"}},
          "blocked_by": {"type": "array", "items": {"type": "string"}},
          "last_receipt": {"type": ["string", "null"]},
          "receipt_chain_head": {"type": "string"},
          "receipt_chain_length": {"type": "integer"},
          "health": {"type": "string", "enum": ["green", "amber", "red", "unknown"]}
        }
      }
    },
    "kpis": {"type": "object"},
    "counter_kpis": {"type": "object"},
    "kill_switch": {
      "type": "object",
      "required": ["global"],
      "properties": {
        "global": {"type": "boolean"},
        "scoped": {"type": "array", "items": {"type": "string"}},
        "verdict": {"type": "string", "enum": ["running", "killed", "unknown"]},
        "read_from": {"type": "array", "items": {"type": "string"}},
        "read_at": {"type": "string"},
        "freshness_s": {"type": ["number", "null"]},
        "fail_closed_engaged": {"type": "boolean"}
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "tokens_spent_today": {"type": "integer"},
        "usd_spent_today": {"type": "number"},
        "day": {"type": "string"},
        "window": {"type": "string"},
        "workspace": {"type": "object"},
        "forecast": {"type": "object"},
        "state": {"type": "string", "enum": ["normal", "escalated", "exhausted"]}
      }
    },
    "sim": {
      "type": "object",
      "properties": {
        "last_run_at": {"type": "string"},
        "suite": {"type": "string"},
        "seeds": {"type": "array", "items": {"type": "integer"}},
        "pass": {"type": "integer"},
        "fail": {"type": "integer"},
        "score": {"type": "number"}
      }
    },
    "open_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "owner"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["low", "med", "high", "critical"]},
          "owner": {"type": "string"},
          "note": {"type": "string"},
          "mitigation_task": {"type": "string"},
          "opened_at": {"type": "string"},
          "updated_at": {"type": "string"}
        }
      }
    },
    "open_tasks": {"type": "array", "items": {"type": "string"}},
    "zombie_leases": {"type": "array", "items": {"type": "object"}},
    "degraded_sense": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true,
  "$defs": {
    "transportStatus": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["up", "down", "degraded", "absent"]},
        "last_ok_at": {"type": ["string", "null"]},
        "consecutive_failures": {"type": "integer", "minimum": 0}
      }
    }
  }
}
